+  void processArmingMailbox() {
+    uint64_t token = 0;
+    bool arm = false;
+    bool rollback = false;
+    {
+      std::lock_guard<std::mutex> lock(m_supervisorMutex);
+      if (!m_commandPending) {
+        return;
+      }
+      token = m_commandToken;
+      arm = m_commandArm;
+      rollback = m_commandRollback;
+      if (m_shuttingDown || !ros::ok()) {
+        m_commandPending = false;
+        m_commandDone = true;
+        m_commandTransportSuccess = false;
+        m_commandError = "shutdown before radio send";
+        auditLocked("queued command cancelled at shutdown", token);
+        m_supervisorCv.notify_all();
+        return;
+      }
+      if (rollback && (m_flyingSeenDuringTransaction || isFlyingLocked())) {
+        m_commandPending = false;
+        m_commandDone = true;
+        m_commandTransportSuccess = false;
+        m_commandError = "rollback prohibited: isFlying=1";
+        setSafetyLatchedLocked(token, m_commandError);
+        m_supervisorCv.notify_all();
+        return;
+      }
+      m_commandPending = false;
+      m_commandSupervisorGenerationAtSend = m_supervisorGeneration;
+      m_armTransactionState = rollback
+        ? ArmTransactionState::RollbackTransport
+        : (arm ? ArmTransactionState::ArmTransport
+               : ArmTransactionState::DisarmTransport);
+      auditLocked(
+        rollback ? "radio dequeued rollback disarm"
+                 : (arm ? "radio dequeued arm" : "radio dequeued disarm"),
+        token);
+    }
+
+    bool transportSuccess = false;
+    std::string error;
+    try {
+      transportSuccess = m_cf.sendArmingRequest(arm);
+      if (!transportSuccess) {
+        error = "arming transport unsupported";
+      }
+    } catch (const std::exception& exc) {
+      error = std::string("arming transport failed: ") + exc.what();
+    }
+
+    {
+      std::lock_guard<std::mutex> lock(m_supervisorMutex);
+      if (m_commandToken != token) {
+        ROS_ERROR("[%s] discarded transport result for stale token=%llu",
+          m_frame.c_str(), static_cast<unsigned long long>(token));
+        return;
+      }
+      m_commandDone = true;
+      m_commandTransportSuccess = transportSuccess;
+      m_commandError = error;
+      auditLocked(
+        std::string("radio transport result=") +
+          (transportSuccess ? "ACK" : "failed") +
+          (error.empty() ? "" : " error=" + error),
+        token);
+    }
+    m_supervisorCv.notify_all();
+  }
